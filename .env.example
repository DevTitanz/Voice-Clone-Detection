# VoxShield AI (SIH26104) - Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH REAL VALUES FOR DEPLOYMENT.
# DO NOT COMMIT THE ACTUAL .env FILE OR EXPOSE SECRETS IN SOURCE CONTROL.

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="VoxShield AI - Real-Time Voice Cloning Detection"
DEBUG=false

# Security & Authentication
# CRITICAL: Generate a cryptographically secure 256-bit secret key in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
# In production, use PostgreSQL with SSL enabled:
# DATABASE_URL=postgresql+asyncpg://db_user:db_password@localhost:5432/voxshield_db
# For local dev / testing fallback:
DATABASE_URL=sqlite+aiosqlite:///./voxshield.db

# CORS Allowed Origins (comma-separated, explicit domains only - NO wildcards in production)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.com

# API Gateway & Reverse Proxy
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# AI Detection Model Settings
MODEL_PATH=builtin-acoustic-v1.2
RISK_THRESHOLD_LOW=40.0
RISK_THRESHOLD_HIGH=70.0

# Rate Limiting
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_UPLOAD=30/minute
RATE_LIMIT_STREAM=120/minute

# Audio Processing Privacy Settings
ALLOW_PERSISTENT_AUDIO=false
MAX_AUDIO_UPLOAD_MB=10
